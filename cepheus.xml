<?xml version="1.0" encoding="UTF-8"?>
<!--
    Xiaomi Mi 9 (cepheus) — uwuAOSP 17.0 (Android 17)

    Device tree and blobs follow JoK3rLeE's 17.0 set, which is the tree
    actually used for Android 17 on this device. The earlier attempt used
    PixelOS's sixteen (Android 16) tree; its BoardConfig asked for
    Image-dtb while this kernel only produces a gzipped Image, so
    mkbootimg was handed a 6-byte "empty" placeholder as the DTB and the
    bootloader dropped to fastboot.

    Build steps are documented in the README of this repository.
-->
<manifest>
  <remote name="oxygenng" fetch="https://github.com/OxygenNG" />
  <remote name="jokerlee" fetch="https://github.com/JoK3rLeE" />
  <remote name="evox" fetch="https://github.com/Evolution-X-Devices" />

  <!-- Device tree: JoK3rLeE 17.0 + uwuAOSP product makefile -->
  <project path="device/xiaomi/cepheus"
           name="android_device_xiaomi_cepheus-uwu"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1" />

  <!-- sm8150-common carries the erofs switch that makes the super group fit -->
  <project path="device/xiaomi/sm8150-common"
           name="android_device_xiaomi_sm8150-common"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1" />

  <!-- Hardware: JoK3rLeE's cnb-cepheus branch -->
  <project path="hardware/xiaomi"
           name="hardware_xiaomi"
           remote="jokerlee"
           revision="cnb-cepheus"
           clone-depth="1" />

  <!-- Kernel: JoK3rLeE 17.0-stable, carries the BPF 5.10 backport -->
  <project path="kernel/xiaomi/sm8150"
           name="android_kernel_xiaomi_sm8150"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1" />

  <!-- Blobs: JoK3rLeE cepheus + Evolution-X sm8150-common -->
  <project path="vendor/xiaomi/cepheus"
           name="proprietary_vendor_xiaomi_cepheus"
           remote="jokerlee"
           revision="16.0"
           clone-depth="1" />

  <project path="vendor/xiaomi/sm8150-common"
           name="vendor_xiaomi_sm8150-common"
           remote="evox"
           revision="cnb"
           clone-depth="1" />

  <!--
    build/make and vendor/uwu carry uwuAOSP fixes (perf-setup-sh, DTBO
    rule, OTA VINTF check). They are applied directly after sync because
    repo cannot replace projects declared by the main manifest from a
    local manifest.
  -->

</manifest>
