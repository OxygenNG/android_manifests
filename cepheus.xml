<?xml version="1.0" encoding="UTF-8"?>
<!--
    Xiaomi Mi 9 (cepheus) — uwuAOSP 17.0 (Android 17)

    Device tree, vendor blobs, and two upstream fixes are carried as
    OxygenNG forks with the port work applied. See each repo's commit
    messages for details.

    Build steps are documented in OxygenNG/android_manifests README.

    Note: uwuAOSP's built-in "github" remote uses fetch="..", resolving
    to https://github.com/uwuAOSP/. Projects in other orgs therefore
    need an absolute-URL remote, as done below.
-->
<manifest>
  <remote name="oxygenng" fetch="https://github.com/OxygenNG" />
  <remote name="lineagegit" fetch="https://github.com/LineageOS" />
  <remote name="jokerlee" fetch="https://github.com/JoK3rLeE" />

  <!-- Device tree: PixelOS sixteen + uwuAOSP port -->
  <project path="device/xiaomi/cepheus"
           name="android_device_xiaomi_cepheus-uwu"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1" />

  <!-- hardware/xiaomi is not in uwuAOSP's manifest, cepheus needs it -->
  <project path="hardware/xiaomi"
           name="android_hardware_xiaomi"
           remote="lineagegit"
           revision="lineage-24.0"
           clone-depth="1" />

  <!-- Kernel: JoK3rLeE 17.0-stable (BPF 5.10 backport, verified booting) -->
  <project path="kernel/xiaomi/sm8150"
           name="android_kernel_xiaomi_sm8150"
           remote="jokerlee"
           revision="17.0-stable"
           clone-depth="1" />

  <!-- Vendor blobs: PixelOS fifteen + audioroute-v34 fix + ssr_setup -->
  <project path="vendor/xiaomi/cepheus"
           name="vendor_xiaomi_cepheus"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1" />

  <!--
    Upstream fixes. uwuAOSP prunes perf-setup-sh but still requires it
    on eng builds, and its DTBO rule calls a make target the Qualcomm
    4.14 kernel does not have. Both are patched in these forks.
  -->
  <remove-project name="platform/build" />
  <project path="build/make"
           name="platform_build_make"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <remove-project name="platform_vendor_uwu" />
  <project path="vendor/uwu"
           name="platform_vendor_uwu"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1" />
</manifest>
