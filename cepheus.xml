<?xml version="1.0" encoding="UTF-8"?>
<!--
    Xiaomi Mi 9 (cepheus) — uwuAOSP 17.0 (Android 17)

    Device tree and vendor blobs are OxygenNG forks of the PixelOS trees
    with the uwuAOSP port applied (see each repo's commit message).

    Usage:
        mkdir -p .repo/local_manifests
        cp cepheus.xml .repo/local_manifests/
        repo sync -c -j8

    Note: uwuAOSP's built-in "github" remote uses fetch="..", resolving to
    https://github.com/uwuAOSP/. Projects in other orgs therefore need an
    absolute-URL remote, as done below.
-->
<manifest>
  <remote name="oxygenng" fetch="https://github.com/OxygenNG" />
  <remote name="lineagegit" fetch="https://github.com/LineageOS" />
  <remote name="jokerlee" fetch="https://github.com/JoK3rLeE" />

  <!-- Device tree: PixelOS sixteen + uwuAOSP port -->
  <project path="device/xiaomi/cepheus"
           name="android_device_xiaomi_cepheus-uwu"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1" />

  <!-- hardware/xiaomi is not in uwuAOSP's manifest, cepheus needs it -->
  <project path="hardware/xiaomi"
           name="android_hardware_xiaomi"
           remote="lineagegit"
           revision="lineage-24.0"
           clone-depth="1" />

  <!-- Kernel: JoK3rLeE 17.0-stable (BPF 5.10 backport, verified booting) -->
  <project path="kernel/xiaomi/sm8150"
           name="android_kernel_xiaomi_sm8150"
           remote="jokerlee"
           revision="17.0-stable"
           clone-depth="1" />

  <!-- Vendor blobs: PixelOS fifteen + audioroute-v34 fix + ssr_setup -->
  <project path="vendor/xiaomi/cepheus"
           name="vendor_xiaomi_cepheus"
           remote="oxygenng"
           revision="oxygenng/uwu-a17"
           clone-depth="1" />
</manifest>
